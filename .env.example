# ---------------------------------------------------------------------------
# Shared infrastructure configuration (Docker) - Online Travel Agency
# Copy this file to `.env` then adjust the values.
#     cp .env.example .env
# The `.env` file must NEVER be committed (it is listed in .gitignore).
# ---------------------------------------------------------------------------

# --- MySQL server --------------------------------------------------------
MYSQL_ROOT_PASSWORD=root_dev_password
MYSQL_ROOT_USER=root

# Port published on the host machine (avoids a clash with a local MySQL)
MYSQL_EXTERNAL_PORT=3307

# Official image (8.4 = LTS)
MYSQL_IMAGE=mysql:8.4

# --- phpMyAdmin service (optional) ---------------------------------------
PHPMYADMIN_EXTERNAL_PORT=8080

# --- The single shared database ------------------------------------------
# One database for the whole project, one application account for the four
# services. The password is read by `db/init/00-create-databases.sh`.
APP_DB_NAME=travel_agency
APP_DB_USER=app_user
APP_DB_PASSWORD=app_pwd_2026

# --- Application services ------------------------------------------------
# SECRET_KEY is the Flask secret; JWT_SECRET must be identical in every
# service or tokens issued by the user service are rejected.
SECRET_KEY=change_me_flask_secret
JWT_SECRET=change_me_shared_jwt_secret_at_least_32_characters
JWT_TTL_MINUTES=120

# Origin of the Angular frontend published by this compose file.
CORS_ORIGINS=http://localhost:4200

# Inter-service calls (timeout in seconds, number of attempts).
SERVICE_TIMEOUT=3
SERVICE_ATTEMPTS=2
DECLINED_CARD_SUFFIX=0002

# --- Frontend mock accounts (local testing only) ---------------------------
# Fake accounts used ONLY when `MOCK_MODE = true` in
# `frontend/src/services/global.service.ts`. With no backend running the app
# answers every request itself from `frontend/src/public/data/*.json`.
# These are throwaway demo credentials, never real secrets: do not reuse them
# anywhere, and delete this section once the 4 real services answer.
#
# Same password for both accounts.
MOCK_ADMIN_EMAIL=admin@agency.travel
MOCK_CLIENT_EMAIL=client@agency.travel
MOCK_PASSWORD=Password123!
#
# Seeded in `frontend/src/public/data/admin.json` and `client.json`, the
# password is applied by `DEMO_PASSWORD` in `mock-backend.service.ts` (min 8
# characters, enforced by the register endpoint).
#
# Testing the declined payment path: on the payment page use any card number
# ending with `0002`, the mock returns 402 PAYMENT_DECLINED.