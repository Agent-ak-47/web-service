# ---------------------------------------------------------------------------
# Shared database service (db/) - MySQL connection settings.
# Copy these variables into the `.env` file of the REST service that uses this
# module. Never commit the real `.env`.
#
# Inside docker compose the MySQL host is the Compose service name `mysql`.
# When a service runs on the workstation (outside Docker), use `127.0.0.1`
# and the published port `3307` instead.
# ---------------------------------------------------------------------------

DB_HOST=mysql
DB_PORT=3306
DB_NAME=travel_agency
DB_USER=app_user

# Must match APP_DB_PASSWORD from the repository root `.env`; the account is
# created by `db/init/00-create-databases.sh`.
DB_PASSWORD=app_pwd_2026

# Maximum number of connections kept in the pool (default: 10).
DB_POOL_SIZE=10
