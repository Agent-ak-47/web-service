# ---------------------------------------------------------------------------
# Values read by kamal/docker-compose.yml when the three services run in Docker.
# Copy this file to `kamal/.env` and change the secrets:
#   cp kamal/.env.example kamal/.env
# The `.env` file is ignored by Git and must never be committed.
# ---------------------------------------------------------------------------

# Flask secret and JWT signing secret. JWT_SECRET must be identical in the
# user, reservation and payment containers, otherwise a token issued by the
# user service is rejected by the other two.
SECRET_KEY=change_me_flask_secret
JWT_SECRET=change_me_shared_jwt_secret_at_least_32_characters
JWT_TTL_MINUTES=120

# MySQL: the `mysql` container of the root docker-compose.yml, internal port.
# Never 127.0.0.1 here — inside a container that is the container itself.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=travel_agency
DB_USER=app_user
DB_PASSWORD=app_pwd_2026

# Angular dev server allowed by CORS (comma separated list).
CORS_ORIGINS=http://localhost:4200

# Catalogue services. They are not containerised: these are the mocks started
# on the host machine (kamal/mock), reached through host.docker.internal.
FLIGHT_SERVICE_URL=http://host.docker.internal:8081
PACKAGE_SERVICE_URL=http://host.docker.internal:8082
EXCURSION_SERVICE_URL=http://host.docker.internal:8084

# 3 seconds and at most 2 attempts per inter-service call.
SERVICE_TIMEOUT=3
SERVICE_ATTEMPTS=2

# Any card number ending with these digits is refused.
DECLINED_CARD_SUFFIX=0002
