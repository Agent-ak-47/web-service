# ---------------------------------------------------------------------------
# Payment service - local development values.
# Copy this file to `.env` in this folder, then change every secret.
# The `.env` file is ignored by Git and must never be committed.
# ---------------------------------------------------------------------------

# HTTP port of this service (8083 is the user service, 8085 the reservation one).
PORT=8086

# Flask secret and JWT signing secret. JWT_SECRET must be identical in the
# user, reservation and payment services, otherwise tokens are rejected.
SECRET_KEY=change_me_flask_secret
JWT_SECRET=change_me_shared_jwt_secret_at_least_32_characters

# MySQL. From the workstation use 127.0.0.1 + the published port 3307.
# Local machine (default): DB_HOST=127.0.0.1, DB_PORT=3306.
# Docker (only if explicitly requested): DB_HOST=mysql, DB_PORT=3306.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=travel_agency
DB_USER=app_user
DB_PASSWORD=app_pwd_2026
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Angular dev server allowed by CORS (comma separated list).
CORS_ORIGINS=http://localhost:4200

# Catalogue services called to release seats during a refund. Inside docker
# compose use the Compose service names (flight-service, package-service,
# excursion-service).
FLIGHT_SERVICE_URL=http://localhost:8081
PACKAGE_SERVICE_URL=http://localhost:8082
EXCURSION_SERVICE_URL=http://localhost:8084

# 3 seconds and at most 2 attempts per inter-service call.
SERVICE_TIMEOUT=3
SERVICE_ATTEMPTS=2

# Simulated bank decline: any card number ending with these digits is refused.
# 4000000000000002 is a standard test card for this use case.
DECLINED_CARD_SUFFIX=0002
