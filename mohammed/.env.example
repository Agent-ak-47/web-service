# ---------------------------------------------------------------------------
# Flight service (Mohammed) - Docker environment values.
# Copy this file to `.env` in the `mohammed/` folder.
# The `.env` file is ignored by Git and must never be committed.
#
# NOTE: this is read by mohammed/docker-compose.yml (the service running inside
# Docker). The backend's own mohammed/backend/.env is used for local runs.
# ---------------------------------------------------------------------------

DB_HOST=mysql
DB_PORT=3306
DB_NAME=travel_agency
DB_USER=app_user
DB_PASSWORD=app_pwd_2026

# MUST match the Auth / Reservation services (Kamal).
JWT_SECRET=change_me_shared_jwt_secret_at_least_32_characters

CORS_ORIGINS=http://localhost:4200
