{
  "info": {
    "name": "ATLAS TRIPS - API tests",
    "description": "Postman/Newman API campaign for the six ATLAS TRIPS services. Run it against the Docker stack (or the local services) with the matching environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "token", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "reservationId", "value": "" },
    { "key": "reservationToCancelId", "value": "" },
    { "key": "reservationPaidId", "value": "" },
    { "key": "reservationDeclinedId", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "flightId", "value": "" },
    { "key": "packageId", "value": "" },
    { "key": "excursionId", "value": "" }
  ],
  "item": [
    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "Register a client",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('qaEmail', 'qa-' + Date.now() + '@agency.travel');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registration accepted or email already used', () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"QA Client\",\n  \"email\": \"{{qaEmail}}\",\n  \"password\": \"Password123!\",\n  \"phone\": \"+212600000000\",\n  \"address\": \"Casablanca\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{userUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login client",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('client login succeeds', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('token is returned', () => pm.expect(body.data.jeton).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('token', body.data.jeton);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"{{clientPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{userUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('admin login succeeds', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('admin role is returned', () => pm.expect(body.data.user.role).to.eql('ADMIN'));",
                  "pm.collectionVariables.set('adminToken', body.data.jeton);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{userUrl}}/api/auth/login"
          }
        },
        {
          "name": "Get current profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('profile is returned', () => pm.response.to.have.status(200));",
                  "pm.test('profile contains an email', () => pm.expect(pm.response.json().data.email).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{userUrl}}/api/auth/me"
          }
        },
        {
          "name": "Update current profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('profile update succeeds', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Customer\",\n  \"phone\": \"+212522000000\",\n  \"address\": \"Casablanca\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{userUrl}}/api/auth/me"
          }
        }
      ]
    },
    {
