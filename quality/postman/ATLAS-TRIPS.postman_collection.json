          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"airline\": \"QA Airline\",\n  \"flightNumber\": \"{{qaFlightNumber}}\",\n  \"departureCity\": \"Casablanca\",\n  \"arrivalCity\": \"Marrakech\",\n  \"departureTime\": \"2027-06-10T08:00:00\",\n  \"arrivalTime\": \"2027-06-10T09:00:00\",\n  \"price\": 900,\n  \"totalSeats\": 120,\n  \"availableSeats\": 120,\n  \"active\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{flightUrl}}/api/flights"
          }
        },
        {
          "name": "Update the created flight",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('flight update succeeds', () => pm.response.to.have.status(200));",
                  "pm.test('price was updated', () => pm.expect(pm.response.json().data.price).to.eql(950));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"airline\": \"QA Airline\",\n  \"flightNumber\": \"{{qaFlightNumber}}\",\n  \"departureCity\": \"Casablanca\",\n  \"arrivalCity\": \"Marrakech\",\n  \"departureTime\": \"2027-06-10T08:00:00\",\n  \"arrivalTime\": \"2027-06-10T09:00:00\",\n  \"price\": 950,\n  \"totalSeats\": 120,\n  \"availableSeats\": 120,\n  \"active\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{flightUrl}}/api/flights/{{flightId}}"
          }
        },
        {
          "name": "Reserve and release flight seats",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('internal reserve succeeds', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 1,\n  \"reservationId\": 999999\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{flightUrl}}/api/internal/flights/{{flightId}}/reserve"
          }
        },
        {
          "name": "Release the reserved flight seats",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('internal release succeeds', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 1,\n  \"reservationId\": 999999\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{flightUrl}}/api/internal/flights/{{flightId}}/release"
          }
        },
        {
          "name": "Delete the created flight",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('flight deletion succeeds', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{flightUrl}}/api/flights/{{flightId}}"
          }
        }
      ]
    },
