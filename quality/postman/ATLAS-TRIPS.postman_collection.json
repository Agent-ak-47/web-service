                ]
              }
            }
          ],
          "request": { "method": "GET", "header": [], "url": "{{flightUrl}}/api/flights" }
        },
        {
          "name": "Get flight 5",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('flight detail succeeds', () => pm.response.to.have.status(200));",
                  "pm.test('flight has an id', () => pm.expect(pm.response.json().data.id).to.eql(5));"
                ]
