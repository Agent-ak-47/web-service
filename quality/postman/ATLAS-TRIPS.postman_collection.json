          "request": { "method": "GET", "header": [], "url": "{{flightUrl}}/api/flights/5" }
        },
        {
          "name": "Get flight availability",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('flight availability succeeds', () => pm.response.to.have.status(200));",
