# Copy this file to `.env` and edit the values to match your local environment.
PORT=8082
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=travel_agency
DB_USER=app_user
DB_PASSWORD=

# Must be identical to JWT_SECRET of the user / reservation / payment services.
JWT_SECRET=

# Comma separated list of the allowed origins.
CORS_ORIGINS=http://localhost:4200

# Catalogue services used to build the composition of a package.
FLIGHT_SERVICE_URL=http://localhost:8081
EXCURSION_SERVICE_URL=http://localhost:8084
# Connect/read timeout of those calls, in seconds.
SERVICE_TIMEOUT=5

# --- Docker (package-service/docker-compose.yml) ----------------------------
# In the container DB_HOST/DB_PORT are fixed to mysql:3306 by the compose file,
# and the values above (127.0.0.1:3307, localhost) are ignored for them.
# DB_PASSWORD, JWT_SECRET, DB_NAME, DB_USER, CORS_ORIGINS and SERVICE_TIMEOUT
# are shared with the host run. Optional overrides of the catalogue URLs:
# DOCKER_FLIGHT_SERVICE_URL=http://host.docker.internal:8081
# DOCKER_EXCURSION_SERVICE_URL=http://host.docker.internal:8084
